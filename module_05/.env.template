# Copy this file to .env and fill in your workspace values.
# .env is gitignored. Never commit a filled-in copy.

DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<your-warehouse-id>
DATABRICKS_CATALOG=<your-catalog>
# Use your OWN schema (for example dbt_<initial><lastname>) so learners do not overwrite each other.
DATABRICKS_SCHEMA=module_05
DATABRICKS_TOKEN=<your-pat-token>
